<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="投递材料助手 · ApplyKit 1.1.0" Width="1260" Height="880" MinWidth="1080" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F3F5F9" FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" FontSize="13" Foreground="#172B45" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#172B45"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#243B53"/><Setter Property="BorderBrush" Value="#DCE3EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#087F68"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Nav" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#BACADB"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="16,14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="N" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="N" Property="Background" Value="#23445B"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="N" Property="Background" Value="#20384E"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="N" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D8E0E9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="#FBFCFE"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E0E9"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="#344D65"/></Style>
  <Style TargetType="ListView"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="White"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="ListViewItem"><Setter Property="Padding" Value="5,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#F5F7FA"/><Setter Property="Foreground" Value="#667A90"/><Setter Property="Padding" Value="6,10"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Margin" Value="0,14,0,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#344D65"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#718197"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="LineHeight" Value="18"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#13283D">
   <Grid Margin="17,29,17,20">
    <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal"><Border Width="34" Height="34" CornerRadius="9" Background="#25B397"><TextBlock Text="✓" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ApplyKit" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
     <TextBlock Text="投 递 材 料 助 手" Foreground="#91A8BE" Margin="3,13,0,0" FontSize="12"/>
    </StackPanel>
    <StackPanel Grid.Row="1">
     <TextBlock Text="材料工作台" Foreground="#6E8AA3" FontSize="11" Margin="14,0,0,12"/>
     <RadioButton x:Name="NavPdfImages" GroupName="Mode" Tag="pdf-images" Content="01   PDF 转图片" Style="{StaticResource Nav}" IsChecked="True"/>
     <RadioButton x:Name="NavImageCompress" GroupName="Mode" Tag="image-compress" Content="02   图片压缩" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavImagesPdf" GroupName="Mode" Tag="images-pdf" Content="03   图片合并 PDF" Style="{StaticResource Nav}"/>
     <RadioButton x:Name="NavPdfCompress" GroupName="Mode" Tag="pdf-compress" Content="04   扫描版 PDF 压缩" Style="{StaticResource Nav}"/>
     <Border Background="#20394D" CornerRadius="8" Padding="13" Margin="0,30,0,0"><TextBlock Text="每个文件单独校验。&#10;不覆盖你的原始材料。" Foreground="#A7BDCE" FontSize="11" TextWrapping="Wrap" LineHeight="21"/></Border>
    </StackPanel>
    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
     <TextBlock Text="●  本地处理，不上传文件" Foreground="#74D7B9" FontSize="11" Margin="5,0,0,11"/>
     <Button x:Name="HelpButton" Content="使用说明 / 版本信息" Background="#20394D" Foreground="#C9D7E5" BorderThickness="0" FontSize="11" Padding="10,8"/>
     <TextBlock Text="ApplyKit  1.0.0  ·  Windows" Foreground="#6E8AA3" FontSize="10" Margin="5,12,0,0"/>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="25,22,25,18">
   <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="*"/><RowDefinition Height="98"/></Grid.RowDefinitions>
   <Grid>
    <StackPanel>
     <TextBlock x:Name="ModeTitle" Text="PDF 转图片" FontSize="26" FontWeight="Bold"/>
     <TextBlock x:Name="ModeDescription" Text="把简历、成绩单与证书转成可提交的图片，每页单独导出。" Foreground="#718197" Margin="1,10,0,0" FontSize="12"/>
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E0F1EB" CornerRadius="16" Padding="12,7" Margin="0,5,0,0"><TextBlock x:Name="LimitBadge" Text="默认每张 &lt; 2MB" Foreground="#11765C" FontSize="11" FontWeight="SemiBold"/></Border>
   </Grid>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="146"/></Grid.RowDefinitions>
     <Border Background="White" CornerRadius="12" BorderBrush="#E3E9EF" BorderThickness="1" Padding="16,12">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
       <DockPanel>
        <Button x:Name="AddButton" DockPanel.Dock="Right" Content="＋ 添加文件" Style="{StaticResource Primary}" Padding="13,7" Margin="10,0,0,7"/>
        <TextBlock x:Name="QueueTitle" Text="待处理材料  ·  0 项" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="0,0,0,7"/>
       </DockPanel>
       <TabControl x:Name="WorkspaceTabs" Grid.Row="1" BorderThickness="0" Background="White" Padding="0,8,0,0">
        <TabItem Header="文件队列">
         <Grid x:Name="DropZone" AllowDrop="True" Background="Transparent">
          <ListView x:Name="InputList" SelectionMode="Extended" AllowDrop="True">
           <ListView.View><GridView><GridViewColumn Header="序号" Width="42" DisplayMemberBinding="{Binding Index}"/><GridViewColumn Header="文件名" Width="250" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}"/><GridViewColumn Header="格式" Width="58" DisplayMemberBinding="{Binding Type}"/></GridView></ListView.View>
          </ListView>
          <Border x:Name="EmptyOverlay" IsHitTestVisible="False" BorderBrush="#D8E5EB" BorderThickness="1" CornerRadius="9" Margin="7,14,7,8" Background="#FBFDFE">
           <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
            <TextBlock Text="＋" FontSize="38" Foreground="#6CA396" HorizontalAlignment="Center"/>
            <TextBlock Text="把材料拖到这里" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="DropHint" Text="支持批量添加 PDF 文件" Foreground="#7B8EA1" HorizontalAlignment="Center" FontSize="11" Margin="0,10,0,0"/>
            <TextBlock Text="也可以点击右上角「添加文件」" Foreground="#95A4B2" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/>
           </StackPanel>
          </Border>
         </Grid>
        </TabItem>
        <TabItem Header="处理结果">
         <ListView x:Name="ResultList" SelectionMode="Single">
          <ListView.View><GridView><GridViewColumn Header="输出 / 输入" Width="210" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding StatusText}"/><GridViewColumn Header="原大小" Width="82" DisplayMemberBinding="{Binding BeforeText}"/><GridViewColumn Header="输出大小" Width="90" DisplayMemberBinding="{Binding AfterText}"/><GridViewColumn Header="体积变化" Width="82" DisplayMemberBinding="{Binding ChangeText}"/></GridView></ListView.View>
         </ListView>
        </TabItem>
       </TabControl>
       <DockPanel Grid.Row="2" Margin="0,6,0,0">
        <TextBlock x:Name="TotalSize" DockPanel.Dock="Right" Text="合计 0 KB" Foreground="#8393A5" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
        <StackPanel Orientation="Horizontal">
         <Button x:Name="RemoveButton" Content="移除" Padding="9,5" FontSize="11" Margin="0,0,5,0"/>
         <Button x:Name="UpButton" Content="上移 ↑" Padding="9,5" FontSize="11" Margin="0,0,5,0"/>
         <Button x:Name="DownButton" Content="下移 ↓" Padding="9,5" FontSize="11" Margin="0,0,5,0"/>
         <Button x:Name="ClearButton" Content="清空" Padding="9,5" FontSize="11"/>
        </StackPanel>
       </DockPanel>
      </Grid>
     </Border>
     <Border Grid.Row="2" Background="White" CornerRadius="12" BorderBrush="#E3E9EF" BorderThickness="1" Padding="17,14">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel><Button x:Name="PreviewButton" DockPanel.Dock="Right" Content="预览所选" Padding="10,5" FontSize="11"/><TextBlock Text="结果检查" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
       <TextBlock x:Name="DetailText" Grid.Row="1" Text="处理后选择结果，可以查看实际字节数、像素尺寸和清晰度提示。提交前请预览姓名、证书编号、细小文字和印章。" FontSize="11" TextWrapping="Wrap" Foreground="#6F8196" LineHeight="19" Margin="0,7,0,4" MaxHeight="66" TextTrimming="CharacterEllipsis"/>
       <TextBlock Grid.Row="2" Text="压缩无收益时保留原件；不把超限文件标记为成功。" Foreground="#20846D" FontSize="10"/>
      </Grid>
     </Border>
    </Grid>
    <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E3E9EF" BorderThickness="1" Padding="18,16">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="SettingsPanel" Margin="0,0,3,5">
       <TextBlock Text="导出设置" FontSize="15" FontWeight="Bold"/>
       <TextBlock Text="优先保留清晰度，再控制文件体积。" Style="{StaticResource Hint}"/>
       <StackPanel x:Name="FormatPanel"><TextBlock Text="输出格式" Style="{StaticResource Label}"/><ComboBox x:Name="FormatBox" SelectedIndex="0"><ComboBoxItem Content="JPG（投递推荐）" Tag="jpg"/><ComboBoxItem Content="JPEG（与 JPG 同编码）" Tag="jpeg"/><ComboBoxItem Content="PNG" Tag="png"/><ComboBoxItem Content="GIF（静态 256 色）" Tag="gif"/></ComboBox></StackPanel>
       <TextBlock x:Name="LimitLabel" Text="每张图片大小上限" Style="{StaticResource Label}"/>
       <ComboBox x:Name="LimitBox" SelectedIndex="0"><ComboBoxItem Content="2 MB · 安全目标 1.90 MB" Tag="2000000"/><ComboBoxItem Content="1 MB · 安全目标 950 KB" Tag="1000000"/><ComboBoxItem Content="500 KB · 安全目标 475 KB" Tag="500000"/><ComboBoxItem Content="200 KB · 安全目标 190 KB" Tag="200000"/><ComboBoxItem Content="自定义（单位 KB）" Tag="custom"/></ComboBox>
       <TextBox x:Name="CustomLimit" Text="2000" Margin="0,7,0,0" Visibility="Collapsed" ToolTip="十进制 KB；例如 2000 KB = 2,000,000 字节。范围 10～100000。"/>
       <TextBlock x:Name="LimitHint" Text="按十进制 2,000,000 字节校验，并预留 5% 余量。" Style="{StaticResource Hint}"/>
       <TextBlock Text="清晰度策略" Style="{StaticResource Label}"/>
       <ComboBox x:Name="ProfileBox" SelectedIndex="0"><ComboBoxItem Content="平衡（推荐）" Tag="balanced"/><ComboBoxItem Content="清晰优先（可能无法达标）" Tag="clear"/><ComboBoxItem Content="体积优先（请仔细检查小字）" Tag="small"/></ComboBox>
       <StackPanel x:Name="DpiPanel"><TextBlock Text="PDF 渲染分辨率" Style="{StaticResource Label}"/><ComboBox x:Name="DpiBox" SelectedIndex="1"><ComboBoxItem Content="150 DPI" Tag="150"/><ComboBoxItem Content="200 DPI（推荐）" Tag="200"/><ComboBoxItem Content="300 DPI" Tag="300"/></ComboBox></StackPanel>
       <Border x:Name="CropPanel" Background="#EFF8F4" BorderBrush="#CCE6DB" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,15,0,0">
        <StackPanel>
         <TextBlock Text="页面裁剪 · 去除四周留白" FontWeight="SemiBold" FontSize="12" Foreground="#216B59"/>
         <ComboBox x:Name="CropModeBox" SelectedIndex="0" Margin="0,9,0,0"><ComboBoxItem Content="不裁剪（默认）" Tag="none"/><ComboBoxItem Content="自动去白边 · 每页独立" Tag="auto"/><ComboBoxItem Content="统一白边 · 同一 PDF 内容并集" Tag="uniform"/><ComboBoxItem Content="手动框选 · 使用已保存方案" Tag="manual"/></ComboBox>
         <TextBlock Text="自动识别范围" Style="{StaticResource Hint}" Margin="0,10,0,5"/>
         <ComboBox x:Name="CropThresholdBox" SelectedIndex="0"><ComboBoxItem Content="保守 · 阈值 250（推荐）" Tag="250"/><ComboBoxItem Content="仅纯白 · 阈值 254" Tag="254"/><ComboBoxItem Content="轻度灰底 · 阈值 240（慎用）" Tag="240"/></ComboBox>
         <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock Text="自动裁剪安全边距（mm）" FontSize="11" VerticalAlignment="Center"/><TextBox x:Name="CropMarginBox" Grid.Column="1" Text="2" ToolTip="0～20 mm，仅用于自动建议框。手动裁剪严格使用你确认的框，不额外扩边。"/></Grid>
         <Button x:Name="CropEditButton" Content="打开裁剪预览 / 手动框选…" Margin="0,11,0,0" Padding="9,8"/>
         <DockPanel Margin="0,8,0,0"><Button x:Name="CropClearButton" DockPanel.Dock="Right" Content="清除" Padding="7,4" FontSize="10"/><TextBlock x:Name="CropSummary" Text="尚无手动裁剪方案" Style="{StaticResource Hint}" Margin="0,1,8,0"/></DockPanel>
         <TextBlock Text="先裁剪，再压缩。空白页保留整页；请核对浅色印章和页脚。只裁页面四周，不重排中间空白。" Style="{StaticResource Hint}"/>
        </StackPanel>
       </Border>
       <StackPanel x:Name="PagesPanel"><TextBlock Text="导出页码（留空表示全部）" Style="{StaticResource Label}"/><TextBox x:Name="PagesBox" Text="" ToolTip="例如 1,3-5。对每个 PDF 分别应用；越界会明确报错。"/><TextBlock Text="示例 1,3-5；每页生成一个文件。" Style="{StaticResource Hint}"/></StackPanel>
       <StackPanel x:Name="PasswordPanel"><TextBlock Text="PDF 打开密码（可选）" Style="{StaticResource Label}"/><PasswordBox x:Name="PasswordBox" Padding="8,7" BorderBrush="#D8E0E9"/><TextBlock Text="仅用于本次处理，不写入配置或报告。" Style="{StaticResource Hint}"/></StackPanel>
       <StackPanel x:Name="PaperPanel" Visibility="Collapsed"><TextBlock Text="PDF 页面" Style="{StaticResource Label}"/><ComboBox x:Name="PaperBox" SelectedIndex="0"><ComboBoxItem Content="A4（自动选择横向 / 纵向）" Tag="a4"/><ComboBoxItem Content="跟随图片比例（按 200 DPI）" Tag="fit"/></ComboBox><TextBlock Text="队列从上到下，就是 PDF 的页序。" Style="{StaticResource Hint}"/></StackPanel>
       <CheckBox x:Name="StrictBox" Margin="0,15,0,4"><TextBlock Text="转换结果也必须小于输入总量" TextWrapping="Wrap" FontSize="11"/></CheckBox>
       <TextBlock x:Name="StrictHint" Text="可选：每份 PDF 导出图片的合计小于该 PDF。文字型 PDF 很小，启用后可能无法导出。" Style="{StaticResource Hint}"/>
       <Border x:Name="CompressionNotice" Background="#EAF5EF" CornerRadius="7" Padding="10" Margin="0,14,0,0" Visibility="Collapsed"><TextBlock Text="强制不增大：压缩结果必须比原文件小，否则保留原件或报告失败。" Foreground="#277A60" FontSize="11" TextWrapping="Wrap" LineHeight="18"/></Border>
       <Border x:Name="PdfWarning" Background="#FFF3DE" CornerRadius="7" Padding="10" Margin="0,14,0,0" Visibility="Collapsed"><StackPanel><TextBlock Text="扫描版重建：不保留可搜索文字、表单、超链接和数字签名。不要用于需要验证签名的证明材料。" Foreground="#8B5E23" TextWrapping="Wrap" FontSize="11" LineHeight="18"/><CheckBox x:Name="ConsentBox" Margin="0,8,0,0"><TextBlock Text="我已了解，仍要重建扫描版 PDF" TextWrapping="Wrap" FontSize="11"/></CheckBox></StackPanel></Border>
       <TextBlock Text="输出文件夹" Style="{StaticResource Label}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="OutputBox" FontSize="11"/><Button x:Name="BrowseButton" Grid.Column="1" Content="…" Margin="5,0,0,0" Padding="5"/></Grid>
       <TextBlock Text="每次创建独立结果目录，不覆盖同名文件。" Style="{StaticResource Hint}"/>
       <CheckBox x:Name="ZipBox" Margin="0,12,0,0"><TextBlock Text="另外生成 ZIP（仅便于整理）" FontSize="11"/></CheckBox>
       <TextBlock Text="透明图片会合成白底；动态 GIF 不处理。新生成的文件不复制照片 EXIF 信息。" Style="{StaticResource Hint}" Margin="0,13,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Border>
   </Grid>
   <Grid Grid.Row="2" Margin="0,16,0,0">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="18"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0"><TextBlock x:Name="StatusText" Text="添加材料，然后点击「开始处理」。" Foreground="#527084" FontSize="12" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ProgressBar" Height="5" Margin="0,11,0,0" Minimum="0" Maximum="100" Value="0" Foreground="#17977B" Background="#E0E8EE" BorderThickness="0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="OpenOutputButton" Content="打开结果" Padding="13,11" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="CancelButton" Content="停止" Padding="13,11" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="StartButton" Content="开始处理 →" Style="{StaticResource Primary}" Padding="23,12" FontSize="14"/></StackPanel>
    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="大小合规不等于平台必然接受：请同时核对对方要求的尺寸、页数与材料内容。" FontSize="10" Foreground="#8D9AAC" VerticalAlignment="Bottom"/>
   </Grid>
  </Grid>
 </Grid>
</Window>
