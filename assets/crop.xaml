<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PDF 裁剪工作台 · ApplyKit" Width="1160" Height="800" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterOwner" Background="#F3F5F9" FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" FontSize="12" Foreground="#172B45" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="11,8"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#243B53"/><Setter Property="BorderBrush" Value="#DCE3EB"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="7,6"/><Setter Property="BorderBrush" Value="#DCE3EB"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#6F8196"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>
  <Border Background="#142A40" Padding="22,15">
   <DockPanel>
    <Border DockPanel.Dock="Right" Background="#21463F" CornerRadius="5" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="原 PDF 不会被修改" Foreground="#BCEBDD"/></Border>
    <StackPanel><TextBlock Text="框住要保留的内容" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock x:Name="DocumentName" Text="PDF 裁剪工作台" Foreground="#BCCBD8" TextTrimming="CharacterEllipsis" Margin="0,7,12,0"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="276"/></Grid.ColumnDefinitions>
   <Border Background="White" BorderBrush="#E0E7EE" BorderThickness="1" CornerRadius="8" Padding="9">
    <DockPanel><TextBlock DockPanel.Dock="Top" x:Name="PageCountText" Text="正在加载页面…" FontWeight="SemiBold" Margin="3,4,0,12"/><ListBox x:Name="PageList" BorderThickness="0" Background="Transparent" DisplayMemberPath="Label" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel>
   </Border>
   <Border Grid.Column="2" Background="#E1E7EE" BorderBrush="#D6DFE8" BorderThickness="1" CornerRadius="8" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,10"><TextBlock Text="原页面 / 保留区域" FontWeight="SemiBold"/><CheckBox x:Name="MoveMode" DockPanel.Dock="Right" Content="移动现有框" HorizontalAlignment="Right" Margin="12,0,0,0" ToolTip="默认拖动重新画框；勾选后可拖动平移。边框和四角始终可以拖动调整。"/></DockPanel>
     <Grid Grid.Row="1">
      <Viewbox x:Name="PageView" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Center" VerticalAlignment="Center">
       <Canvas x:Name="CropCanvas" Width="800" Height="1100" Background="White" ClipToBounds="True" Focusable="True" Cursor="Cross">
        <Image x:Name="PageImage" Canvas.Left="0" Canvas.Top="0" Width="800" Height="1100" Stretch="Fill" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShadeTop" Fill="#720F243B" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShadeLeft" Fill="#720F243B" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShadeRight" Fill="#720F243B" IsHitTestVisible="False"/>
        <Rectangle x:Name="ShadeBottom" Fill="#720F243B" IsHitTestVisible="False"/>
        <Rectangle x:Name="KeepRect" Stroke="#12A585" StrokeThickness="3" Fill="Transparent" IsHitTestVisible="False"/>
        <Rectangle x:Name="HandleTL" Width="12" Height="12" Fill="White" Stroke="#12A585" StrokeThickness="2" IsHitTestVisible="False"/>
        <Rectangle x:Name="HandleTR" Width="12" Height="12" Fill="White" Stroke="#12A585" StrokeThickness="2" IsHitTestVisible="False"/>
        <Rectangle x:Name="HandleBL" Width="12" Height="12" Fill="White" Stroke="#12A585" StrokeThickness="2" IsHitTestVisible="False"/>
        <Rectangle x:Name="HandleBR" Width="12" Height="12" Fill="White" Stroke="#12A585" StrokeThickness="2" IsHitTestVisible="False"/>
       </Canvas>
      </Viewbox>
      <Border x:Name="LoadingOverlay" Background="#EEF2F6" Padding="25"><StackPanel VerticalAlignment="Center"><TextBlock Text="正在生成本地预览" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="预览采用较低分辨率；正式导出会重新渲染。" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border>
     </Grid>
     <TextBlock Grid.Row="2" x:Name="SelectionText" Text="拖动框选；绿色框内的内容会被保留。" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
    </Grid>
   </Border>
   <Border Grid.Column="4" Background="White" BorderBrush="#E0E7EE" BorderThickness="1" CornerRadius="8" Padding="15">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="EditorControls" IsEnabled="False" Margin="0,0,4,0">
      <TextBlock Text="裁剪结果预览" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
      <Border Background="#EDF1F5" BorderBrush="#E0E7EE" BorderThickness="1" Height="165" Padding="7"><Image x:Name="ResultPreview" Stretch="Uniform"/></Border>
      <TextBlock x:Name="ScopeText" Text="当前页尚未设置裁剪。" Style="{StaticResource Muted}" Margin="0,8,0,10"/>
      <Button x:Name="AutoButton" Content="自动去白边 · 当前页" ToolTip="生成建议框，不识别或重排页面内部空白。请核对后保存。"/>
      <TextBlock x:Name="AutoSettings" Text="阈值 250 · 安全边距 2 mm" Style="{StaticResource Muted}" Margin="0,-2,0,10"/>
      <TextBlock Text="保留区域边界（原页百分比）" FontWeight="SemiBold" Margin="0,3,0,8"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="左边界 %" Style="{StaticResource Muted}"/><TextBlock Grid.Column="2" Text="上边界 %" Style="{StaticResource Muted}"/>
       <TextBox Grid.Row="1" x:Name="LeftValue" Text="0"/><TextBox Grid.Row="1" Grid.Column="2" x:Name="TopValue" Text="0"/>
       <TextBlock Grid.Row="2" Text="右边界 %" Style="{StaticResource Muted}" Margin="0,7,0,0"/><TextBlock Grid.Row="2" Grid.Column="2" Text="下边界 %" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
       <TextBox Grid.Row="3" x:Name="RightValue" Text="100"/><TextBox Grid.Row="3" Grid.Column="2" x:Name="BottomValue" Text="100"/>
      </Grid>
      <Button x:Name="UpdateValuesButton" Content="按数值更新当前框" Margin="0,10,0,8"/>
      <Button x:Name="ApplyAllButton" Content="把当前框应用到本 PDF 全部页" IsEnabled="False"/>
      <Button x:Name="ResetPageButton" Content="当前页恢复完整页面"/>
      <Button x:Name="ResetAllButton" Content="清除本 PDF 的全部裁剪"/>
      <Border Background="#FFF5E4" Padding="10" CornerRadius="6" Margin="0,2,0,0"><TextBlock Text="框外内容不会导出。请核对签字、印章、页脚和淡色文字。此功能只裁四周，不删除页面中间的空白，也不修改原 PDF。" Foreground="#88632D" TextWrapping="Wrap" FontSize="11" LineHeight="19"/></Border>
     </StackPanel>
    </ScrollViewer>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="White" BorderBrush="#DEE6ED" BorderThickness="0,1,0,0" Padding="18,12">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="正在启动本地 PDF 预览…" TextWrapping="Wrap" Foreground="#637C91" VerticalAlignment="Center" Margin="0,0,14,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="CloseButton" Content="取消 / 返回" Margin="0,0,9,0"/><Button x:Name="SaveButton" Content="保存裁剪方案" Background="#158A70" Foreground="White" BorderBrush="#158A70" Padding="18,9" Margin="0" IsEnabled="False"/></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
